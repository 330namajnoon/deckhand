# Instancia de GitLab autoalojada contra la que trabaja deckhand.
GITLAB_HOST=https://gitlab.example.com

# Personal Access Token de GitLab con scope api.
GITLAB_TOKEN=

# Contraseña nueva que se fija en el primer login SSH del entorno, cuando el
# servidor fuerza el cambio de contraseña (utils/loginEntorno.js).
ENTORNO_NEW_PASSWORD=
# Opcional: la misma para los entornos de CRM, que rechazan la anterior por su
# política de contraseñas. Si está vacía, se usa ENTORNO_NEW_PASSWORD.
ENTORNO_NEW_PASSWORD_CRM=

# Puerto del backend (por defecto 4000).
PORT=4000

# Carpeta de datos de deckhand (opcional): base de datos SQLite (deckhand.db)
# y errors.log. Por defecto ~/.deckhand; se crea sola al arrancar.
# DECKHAND_HOME=

# URL pública por la que se accede a este servidor deckhand (detrás de nginx),
# usada para construir el Protected Resource Metadata (mcpServer/wellKnown.js)
# y el resourceMetadataUrl del header WWW-Authenticate. Sin barra final.
MCP_PUBLIC_URL=https://deckhand.sinul.es

# Verificación de los JWT que emite el auth-server, para autenticar las
# peticiones al servidor MCP (mcpServer/auth/). issuer/audience se comprueban
# contra los claims iss/aud del token. audience debe coincidir con el
# `resource` que pide el cliente MCP (MCP_PUBLIC_URL + /mcp) y con
# DECKHAND_RESOURCE_URL en el .env del auth-server.
MCP_AUTH_ISSUER=
MCP_AUTH_AUDIENCE=

# JWKS del auth-server, para verificar la firma del JWT sin llamarlo en cada
# petición (se cachea localmente). Alternativa si el auth-server no expone
# JWKS: fijar MCP_AUTH_PUBLIC_KEY con la clave pública/secreto en su lugar.
MCP_AUTH_JWKS_URI=
MCP_AUTH_PUBLIC_KEY=

# Algoritmos de firma aceptados, separados por comas.
MCP_AUTH_ALGORITHMS=RS256

# Scopes que debe tener el token para poder usar el MCP, separados por comas.
# Vacío = no se exige ningún scope.
MCP_AUTH_REQUIRED_SCOPES=

# Contraseña de los skills/agentes cifrados en private.enc (yarn encrypt:private; mín. 32 caracteres)
PRIVATE_CONTENT_PASSWORD=
