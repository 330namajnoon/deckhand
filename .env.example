# Instancia de GitLab autoalojada contra la que trabaja deckhand.
GITLAB_HOST=https://gitlab.example.com

# Personal Access Token de GitLab con scope api.
GITLAB_TOKEN=

# Contraseña nueva que se fija en el primer login SSH del entorno, cuando el
# servidor fuerza el cambio de contraseña (utils/loginEntorno.js).
ENTORNO_NEW_PASSWORD=

# Puerto del backend (por defecto 4000).
PORT=4000

# Cadena de conexión a la base de datos MariaDB (Prisma). El usuario debe
# tener privilegios sobre la base de datos indicada (ver prisma/schema.prisma).
DATABASE_URL="mysql://deckhand:PASSWORD@localhost:3306/deckhand"
