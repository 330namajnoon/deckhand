node_modules/

# Secretos: token de GitLab, contraseñas de entornos, etc.
.env
.env.*
!.env.example

# Base de datos local de deploys: contiene contraseñas SSH, IPs y hostnames
# internos de los entornos. Solo se versiona la plantilla vacía.
database/deploys.json
# Base de datos SQLite si DECKHAND_DB_PATH apunta dentro del repo
*.db
*.db-wal
*.db-shm
# Log de errores del backend (utils/logError.js)
database/errors.log

# Artefactos de Yarn 4 (nodeLinker: node-modules)
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/versions

# Configuración local de herramientas / SO
.claude/
.vscode/
.idea/
.DS_Store
*.log
*.ovpn

# Skills de asistentes de IA (no son del proyecto)
.windsurf/
.agents/
skills-lock.json

# Skills/agentes/comandos privados: en claro solo en local, se publican cifrados en private.enc
# (yarn encrypt:private). Lo que se versiona en claro son los ficheros públicos de privateContent/paths.js.
skills/*
!skills/README.md
agents/
commands/*
!commands/settings.md
.private-unlocked.json
